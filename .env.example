# jira-mcp — local/dev only. In production, credentials come from
# datumbridge-integrations' POST /internal/v1/inject (vault credentials_json),
# not from these env vars — see JIRA_CREDENTIALS_DIR below for the path-based
# alternative used in some deployments.

# Server
JIRA_MCP_PORT=8012
JIRA_MCP_ALLOWED_ORIGINS=
LOG_LEVEL=INFO

# Local/dev-only credential fallback (never used when credentials_json is
# injected by a tool call)
JIRA_ACCESS_TOKEN=
JIRA_CLOUD_ID=

# Optional: read credentials_path from a jailed directory instead of env
JIRA_CREDENTIALS_DIR=/credentials

# Optional: narrow the full tool catalogue to an explicit allowlist
# (comma-separated tool names). Full scope is the default — leave unset.
JIRA_TOOLS=

# Optional overrides
JIRA_API_BASE=https://api.atlassian.com/ex/jira
JIRA_HTTP_TIMEOUT_SEC=30
